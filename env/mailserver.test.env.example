# Local smoke-test values only. This reserved .test domain will not work with
# Let's Encrypt or public email delivery.

MAIL_DOMAIN=steamapp.test
MAIL_HOSTNAME=mail.steamapp.test
LETSENCRYPT_EMAIL=admin@steamapp.test
POSTMASTER_ADDRESS=postmaster@steamapp.test

# Use a self-signed certificate for local container startup checks.
SSL_TYPE=self-signed

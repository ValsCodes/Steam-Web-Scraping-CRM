# Public hostnames served by the existing host reverse proxy.
STEAMAPP_PUBLIC_HOST=
GRAFANA_PUBLIC_HOST=

# Loopback ports consumed by the host reverse proxy.
STEAMAPP_HTTP_PORT=4200
GRAFANA_HTTP_PORT=3000

# Isolated Compose project configuration.
STEAMAPP_DATABASE=SteamApp
STEAMAPP_NETWORK_SUBNET=172.30.50.0/24
MSSQL_PID=Developer

# Required credentials. Use strong URL-safe values for passwords used in
# connection strings. Client secret hashes must be 64-character SHA-256 hex.
MSSQL_SA_PASSWORD=
JWT_SIGNING_KEY=
STEAMAPP_CLIENT_ID=steam-client
STEAMAPP_CLIENT_SECRET_HASH=
STEAMAPP_INTERNAL_CLIENT_ID=steam-internal
STEAMAPP_INTERNAL_CLIENT_SECRET_HASH=
RABBITMQ_USER=steamapp
RABBITMQ_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Optional application behavior.
AUTHENTICATION_ALLOW_REGISTRATION=false
WISHLIST_WORKER_ENABLED=false
WISHLIST_WORKER_INTERVAL=00:00:30
OTEL_TRACES_SAMPLER=always_on
OTEL_METRIC_EXPORT_INTERVAL=5000

# Required only when WISHLIST_WORKER_ENABLED=true.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_ENABLE_SSL=true
